# ─────────────────────────────────────────────────────────────
#  متجر نُور — Noor Store
#  Copy to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Used for SEO / canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Initial administrator account (created by the seed script / first boot).
ADMIN_EMAIL=admin@noor.dz
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=مدير المتجر

# ── Database ─────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the built-in SQLite database (zero setup,
# stored in .data/noor.db). Perfect for local development.
#
# For production set DATABASE_URL to your Supabase Postgres connection string:
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# When DATABASE_URL is set the app uses PostgreSQL automatically.
DATABASE_URL=

# ── Supabase Storage (optional, recommended for Vercel) ──────
# When set, admin image uploads go to Supabase Storage instead of /public/uploads.
# Create a public bucket named "products" (or change SUPABASE_STORAGE_BUCKET).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=products

# ── Seed demo catalogue on first run (SQLite & PostgreSQL) ──
# Set to false after the first successful deploy.
AUTO_SEED=true
